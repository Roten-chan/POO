<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.gestorestudiantesjson.controller.ListaController"
      spacing="10" alignment="CENTER" prefWidth="700" prefHeight="450">
    <children>
        <Label text="Gestión de estudiantes con JSON"/>
        <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="270"/>
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="100"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10">
            <children>
                <Button text="Agregar ejemplo" onAction="#agregarEjemplo"/>
                <Button text="Cargar JSON" onAction="#cargarJson"/>
                <Button text="Guardar JSON" onAction="#guardarJson"/>
            </children>
        </HBox>
    </children>
</VBox>
